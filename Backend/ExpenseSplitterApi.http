@ExpenseSplitterApi_HostAddress = http://localhost:5033

### Register User 1 (Alice)
POST {{ExpenseSplitterApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Alice Johnson",
  "email": "alice@example.com",
  "password": "Password123!"
}

### Register User 2 (Bob)
POST {{ExpenseSplitterApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Bob Smith",
  "email": "bob@example.com",
  "password": "Password123!"
}

### Register User 3 (Charlie)
POST {{ExpenseSplitterApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Charlie Brown",
  "email": "charlie@example.com",
  "password": "Password123!"
}

### Login User
POST {{ExpenseSplitterApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "Password123!"
}

### Fetch All Users
GET {{ExpenseSplitterApi_HostAddress}}/api/users
Accept: application/json

### Fetch User by ID
GET {{ExpenseSplitterApi_HostAddress}}/api/users/1
Accept: application/json

### Create a Trip
POST {{ExpenseSplitterApi_HostAddress}}/api/trips
Content-Type: application/json

{
  "title": "Summer Road Trip",
  "description": "Cross-country vacation",
  "createdByUserId": 1,
  "initialMemberUserIds": [2]
}

### Fetch All Trips
GET {{ExpenseSplitterApi_HostAddress}}/api/trips
Accept: application/json

### Fetch Trip Details by ID
GET {{ExpenseSplitterApi_HostAddress}}/api/trips/1
Accept: application/json

### Add Member to Trip
POST {{ExpenseSplitterApi_HostAddress}}/api/trips/1/members
Content-Type: application/json

{
  "userId": 3
}

### Fetch Members of Trip
GET {{ExpenseSplitterApi_HostAddress}}/api/trips/1/members
Accept: application/json

### Add an Expense (Automatically splits equally among selected participants)
POST {{ExpenseSplitterApi_HostAddress}}/api/expenses
Content-Type: application/json

{
  "description": "Cabin Rental",
  "amount": 300.00,
  "tripId": 1,
  "paidByUserId": 1,
  "participantUserIds": [1, 2, 3]
}

### Fetch Expense Details by ID
GET {{ExpenseSplitterApi_HostAddress}}/api/expenses/1
Accept: application/json

### Fetch Expenses for a Trip
GET {{ExpenseSplitterApi_HostAddress}}/api/expenses/trip/1
Accept: application/json

### Fetch User 2 (Bob) Dashboard Balances (Owes, Who Paid, Pending/Settled status)
GET {{ExpenseSplitterApi_HostAddress}}/api/users/2/dashboard
Accept: application/json

### Update ExpenseSplit Status to Settled (IsPaid = true)
PUT {{ExpenseSplitterApi_HostAddress}}/api/expenses/splits/2/settle
Accept: application/json

### Fetch User 2 Dashboard Again (Shows Settled)
GET {{ExpenseSplitterApi_HostAddress}}/api/users/2/dashboard
Accept: application/json
